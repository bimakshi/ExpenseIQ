generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  budgets   Budget[]
  expenses  Expense[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  budgets  Budget[]
  expenses Expense[]
}

model Expense {
  id         String   @id @default(cuid())
  amount     Float
  note       String?
  date       DateTime
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Budget {
  id           String   @id @default(cuid())
  monthlyLimit Float
  month        Int
  year         Int
  userId       String
  categoryId   String
  createdAt    DateTime @default(now())
  category     Category @relation(fields: [categoryId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, categoryId, month, year])
}
